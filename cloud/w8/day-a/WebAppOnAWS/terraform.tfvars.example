aws_region   = "ap-southeast-1"
project_name = "webapp"
environment  = "dev"

availability_zones   = ["ap-southeast-1a", "ap-southeast-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

allowed_ssh_cidr_blocks = ["YOUR_PUBLIC_IP/32"]
web_ingress_cidr_blocks = ["0.0.0.0/0"]
key_name                = "your-existing-key-pair"

db_name     = "webapp"
db_username = "admin"
db_password = "ChangeMe12345!"

static_assets_bucket_name = "your-globally-unique-static-assets-bucket"
