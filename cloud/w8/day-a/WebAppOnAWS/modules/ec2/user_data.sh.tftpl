#!/bin/bash
set -euo pipefail

dnf update -y
dnf install -y nginx

cat >/usr/share/nginx/html/index.html <<'HTML'
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Web App on AWS</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      font-family: Arial, sans-serif;
      color: #17202a;
      background: #f4f7fb;
    }
    main {
      width: min(720px, calc(100% - 32px));
      padding: 32px;
      background: white;
      border: 1px solid #d8e0ea;
      border-radius: 8px;
      box-shadow: 0 10px 30px rgba(23, 32, 42, 0.08);
    }
    h1 {
      margin-top: 0;
      font-size: 32px;
    }
    code {
      background: #edf2f7;
      padding: 2px 6px;
      border-radius: 4px;
    }
  </style>
</head>
<body>
  <main>
    <h1>Web App on AWS</h1>
    <p>EC2 web server is running in a public subnet.</p>
    <p>RDS endpoint: <code>${db_endpoint}</code></p>
    <p>Database: <code>${db_name}</code> / User: <code>${db_username}</code></p>
    <p>Static assets bucket: <code>${static_bucket_name}</code></p>
  </main>
</body>
</html>
HTML

systemctl enable nginx
systemctl start nginx
