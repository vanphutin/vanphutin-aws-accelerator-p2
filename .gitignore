# ==============================================================================
# GITIGNORE FOR AWS ACCELERATOR INTERNSHIP PROJECT
# ==============================================================================

# ------------------------------------------------------------------------------
# Terraform / OpenTofu
# ------------------------------------------------------------------------------
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !override.tf

# Include main locks
.terraform.lock.hcl

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ------------------------------------------------------------------------------
# Node.js & Javascript (Web/API Apps)
# ------------------------------------------------------------------------------
# Dependency directories
node_modules/
jspm_packages/
web_modules/
bower_components/

# Debug and runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Coverage directory used by tools like istanbul, nyc
coverage/
*.lcov
.nyc_output/

# Grunt intermediate storage
.grunt/

# node-waf configuration
.lock-wscript

# Compiled binary addons
build/Release/

# TypeScript cache & build info
*.tsbuildinfo

# Optional package manager caches
.npm/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Package manager stores
.yarn/
.pnpm-store/

# Local env files (Secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Build/dist outputs
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.vuepress/dist/
.webpack/
.svelte-kit/


# ------------------------------------------------------------------------------
# Python (AWS Lambda, Automation Scripts)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these written in a common folder. Check if required.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.toml
.cache
.pytest_cache/
.nosetests
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.run/

# Jupyter Notebook
.ipynb_checkpoints

# Virtual Environments
.venv/
venv/
ENV/
env/
ENV/local/
ENV/bin/

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're building a library, you should ignore it:
#Pipfile.lock

# poetry
#   Similarly, poetry.lock is usually committed, but ignore it if needed:
#poetry.lock

# ------------------------------------------------------------------------------
# Docker & Containers
# ------------------------------------------------------------------------------
# Only ignore local/custom docker files if they contain sensitive data.
# Usually, Dockerfile and docker-compose.yml are tracked, but some specific data dirs should be ignored.
# e.g., if you mount a local folder for database data:
# pgdata/
# mysql_data/

# ------------------------------------------------------------------------------
# OS-Specific (Windows, macOS, Linux)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
*.cab
*.msi
*.msm
*.msp

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon\r
ehthumbs.db

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains (IntelliJ, WebStorm, PyCharm, CLion, etc.)
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
.netrwhist
*~
tags
*.un~

# ------------------------------------------------------------------------------
# Archives and Logs
# ------------------------------------------------------------------------------
*.log
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
